rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function affectedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---------- Users ----------
    // Anyone signed in can read basic profiles (search, follow, leaderboard).
    // Only the owner may create/fully edit their own doc.
    // Other authenticated users may ONLY touch specific derived fields
    // (followers array from a Follow action, points/lastPointReason from
    // the gamification engine when they trigger a point award on someone
    // else). This mirrors client-side award calls; for stricter guarantees
    // move point-awarding to Cloud Functions.
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) ||
        (isAuthenticated() && affectedKeys().hasOnly(['followers', 'points', 'lastPointReason']));
      allow delete: if false;
    }

    // ---------- Posts ----------
    match /posts/{postId} {
      allow read: if isAuthenticated() && (
        resource.data.visibility == 'public' ||
        resource.data.authorId == request.auth.uid ||
        (resource.data.visibility == 'friends' &&
          request.auth.uid in resource.data.get('friendIds', []))
      );

      allow create: if isAuthenticated() &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 500;

      // Owner can edit their own text/visibility; anyone authenticated may
      // update ONLY the reactions map or commentsCount (engagement actions).
      allow update: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid ||
        affectedKeys().hasOnly(['reactions']) ||
        affectedKeys().hasOnly(['commentsCount'])
      );

      allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;

      // ---------- Threaded Comments ----------
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
          request.resource.data.authorId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0;
        allow update, delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
      }
    }

    // ---------- Direct Messages ----------
    match /chats/{chatId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isAuthenticated() &&
          request.resource.data.senderId == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow update, delete: if false;
      }
    }

    // ---------- Groups ----------
    match /groups/{groupId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      // Owner can edit anything; any authenticated user may join (append
      // only their own uid to members).
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        (affectedKeys().hasOnly(['members']) &&
          request.resource.data.members.hasAll(resource.data.members) &&
          request.resource.data.members.size() == resource.data.members.size() + 1 &&
          request.auth.uid in request.resource.data.members)
      );
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // ---------- Public Pages ----------
    match /pages/{pageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        affectedKeys().hasOnly(['followers'])
      );
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }
  }
}
